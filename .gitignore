# .gitignore for a C# / .NET project (Visual Studio, dotnet CLI)

.vs/
*.user
*.userosscache
*.suo
*.sln.docstates

# Build directories
bin/
obj/

# Publish outputs (self-contained, RID-specific)
**/publish/
*.Publish.xml

# Rider
.idea/
*.sln.iml
*.DotSettings.user

# Rider caches
.idea/**/workspace.xml

# NuGet packages
*.nupkg
.packages/
.nuget/
.nuget/packages/

# Visual Studio Code settings
.vscode/

# Test result files
TestResults/
*.trx
*.coverage
*.coveragexml

# Logs and temp files
*.log
*.tmp
*.cache

# Rider / ReSharper
_ReSharper*/
*.DotSettings
*.DotSettings.user

# Mono
*.pidb

# Mac / Linux
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Generated files
project.assets.json
*.userprefs

# Ignore publish/runtime files for self-contained builds
*.deps.json
*.runtimeconfig.json

# Optional: ignore local secrets and env files
appsettings.*.json
.env

# Lichess bot token (do not commit)
lichess_token.txt
!lichess_token.example.txt

# Ignore compiled executables (optional, if publish artifacts shouldn't be tracked)
*.exe
*.dll
*.pdb

# Python / virtual environments
.venv/
__pycache__/
*.pyc

# NNUE training artifacts and large datasets
nnue_checkpoints/
datasets/
positions.txt
tuning_dataset_16m.txt
# Keep track of readme/license and source files only
# (Everything else generated by build tools will be ignored by the rules above)
tuning_dataset_16m.txt
.venv310/